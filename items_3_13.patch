diff --git a/.env.example b/.env.example
index 7a550fe..ca7ddb9 100644
--- a/.env.example
+++ b/.env.example
@@ -1,9 +1,8 @@
-# GEMINI_API_KEY: Required for Gemini AI API calls.
-# AI Studio automatically injects this at runtime from user secrets.
-# Users configure this via the Secrets panel in the AI Studio UI.
-GEMINI_API_KEY="MY_GEMINI_API_KEY"
+# PORT: The port the server listens on. Defaults to 3000.
+# PORT=3000
 
-# APP_URL: The URL where this applet is hosted.
-# AI Studio automatically injects this at runtime with the Cloud Run service URL.
-# Used for self-referential links, OAuth callbacks, and API endpoints.
-APP_URL="MY_APP_URL"
+# LAB_PASSPHRASE: Optional shared passphrase for network access.
+# If set, the server binds to 0.0.0.0 (all interfaces) and requires
+# an "Authorization: Bearer <LAB_PASSPHRASE>" header on all API requests.
+# If NOT set, the server binds to 127.0.0.1 (localhost only) for maximum security.
+# LAB_PASSPHRASE="your-lab-passphrase-here"
